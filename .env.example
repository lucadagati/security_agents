# Ollama HTTP endpoint pointing at the L40 host (provided separately).
# Example: http://gpu-host.internal:11434
COEVSEC_OLLAMA_BASE_URL=http://localhost:11434

# Default / volume model for high-volume episodes.
COEVSEC_OLLAMA_MODEL=qwen2.5:14b

# Stronger model reserved for selected experiments.
COEVSEC_OLLAMA_MODEL_STRONG=qwen3-coder:30b

# Optional smaller / alternate baselines.
COEVSEC_OLLAMA_MODEL_SMALL=qwen2.5-coder:7b
COEVSEC_OLLAMA_MODEL_ALT=llama3.1:8b

# Telegram progress bot (optional).
# COEVSEC_TELEGRAM_BOT_TOKEN=
# COEVSEC_TELEGRAM_CHAT_ID=

# PostgreSQL DSN for telemetry ingestion (optional; JSONL always written).
COEVSEC_PG_DSN=postgresql://coevsec:coevsec@localhost:5432/coevsec
